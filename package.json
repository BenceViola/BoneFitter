  },
  "homepage": "https://benceviola.github.io/BoneFitter/",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "three": "0.170.0",
    "three-mesh-bvh": "0.8.3"
  }
}
